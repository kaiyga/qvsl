#cloud-config
chpasswd: 
  list:
    - root:P@ssw0rd
  expire: false
runcmd:
  - sed -i 's/[Dd]isallow[Pp]assword[Aa]uth[Yy]es/allowpasswordauthyes/g' /etc/ssh/sshd_config.d/*.conf || true
  - sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf
  - echo "PermitRootLogin yes" >> /etc/ssh/sshd_config.d/50-cloud-init.conf
  - rc-service sshd restart
  - echo "" > /root/from-user-data-secret

#!/usr/bin/env bash
set -euo pipefail

. /app/lib/http-source.sh
. /app/lib/disk-mgr.sh
. /app/lib/disk-cli.sh
. /app/lib/cloud-init-mgr.sh
. /app/lib/cloud-init-cli.sh
. /app/lib/network-mgr.sh
. /app/lib/network-cli.sh

echo "==> Initializing VM startup: {{ .vm.name }}"

check_kvm() {
    if [ ! -e /dev/kvm ]; then
        echo "ERROR: /dev/kvm not found! Ensure KVM is passed through to container." >&2
        exit 1
    fi
}

check_kvm

QEMU_CMD=(
    "qemu-system-{{ .vm.arch }}"
    "-enable-kvm"
    "-name" "{{ .vm.name }}"
    "-machine" "{{ default "q35" .vm.machine_type }}"
    "-cpu" "host"
    "-smp" "{{ .vm.cpu_cores }}"
    "-m" "{{ .vm.memory_mb }}"
    "-serial" "stdio"
)

echo "--> Processing storage..."
{{ if .drives }}
{{ range $index, $drive := .drives }}
  {{ $tmplSource := "" }}
  {{ $tmplMode := "" }}
  {{ $tmplFormat := "" }}
  {{ if $drive.template }}
    {{ $tmplSource = default "" $drive.template.source }}
    {{ $tmplMode = default "" $drive.template.mode }}
    {{ $tmplFormat = default "" $drive.template.format }}
  {{ end }}

  mgr_ensure_disk \
    "{{ $drive.type }}" \
    "{{ $drive.path }}" \
    "{{ $drive.format }}" \
    "{{ default "" $drive.size }}" \
    "{{ $tmplSource }}" \
    "{{ $tmplMode }}" \
    "{{ $tmplFormat }}"

  read -r -a DISK_ARGS <<< "$(cli_add_disk "{{ $drive.path }}" "{{ $drive.format }}")"
  QEMU_CMD+=("${DISK_ARGS[@]}")
{{ end }}
{{ end }}

DEFAULT_USER_DATA_PATH="/tmp/cloud-init-user-data.yaml"
DEFAULT_NET_CONFIG_PATH="/tmp/cloud-init-network-config.yaml"

USER_DATA_FILE=""
NET_CONFIG_FILE=""

{{ if .cloud_init }}
  {{ if .cloud_init.user_data_url }}
    download_if_url "{{ .cloud_init.user_data_url }}" "$DEFAULT_USER_DATA_PATH"
    USER_DATA_FILE="$DEFAULT_USER_DATA_PATH"
  {{ else if .cloud_init.user_data_path }}
    USER_DATA_FILE="{{ .cloud_init.user_data_path }}"
  {{ else if or .cloud_init.configRaw .cloud_init.config }}
    USER_DATA_FILE="$DEFAULT_USER_DATA_PATH"
    cat << 'EOF' > "$USER_DATA_FILE"
#cloud-config
{{ if .cloud_init.configRaw }}
{{ .cloud_init.configRaw }}
{{ else }}
{{ .cloud_init.config | toYaml }}
{{ end }}
EOF
  {{ end }}
{{ end }}

{{ if .networks }}
NET_CONFIG_FILE="$DEFAULT_NET_CONFIG_PATH"
cat << 'EOF' > "$NET_CONFIG_FILE"
{{ include "qvsl.networkConfig" . }}
EOF
{{ end }}

if [ -n "$USER_DATA_FILE" ] && [ -f "$USER_DATA_FILE" ]; then
    mgr_setup_cloud_init "$USER_DATA_FILE" "${NET_CONFIG_FILE:-}" "" "{{ .vm.name }}"
    read -r -a CI_ARGS <<< "$(cli_add_cdrom "/vm/disks/cloud-init.iso")"
    QEMU_CMD+=("${CI_ARGS[@]}")
fi

echo "--> Processing networks..."
{{ if .networks }}
{{ range $netIndex, $net := .networks }}
  {{ $ipList := "" }}
  {{ if $net.ips }}
    {{ $ipList = join "," $net.ips }}
  {{ else if $net.ip }}
    {{ $ipList = $net.ip }}
  {{ end }}

  {{ if eq $net.type "bridge" }}
    mgr_prepare_bridge_net \
      "{{ $netIndex }}" \
      "{{ $net.bridge_interface }}" \
      "{{ $.vm.name }}" \
      "{{ $ipList }}" \
      "{{ default "" $net.mac }}" \
      "{{ default "false" $net.anti_spoof }}"

    read -r -a NET_ARGS <<< "$(cli_add_bridge_network "{{ $netIndex }}" "{{ $net.bridge_interface }}" "{{ $.vm.name }}")"
    QEMU_CMD+=("${NET_ARGS[@]}")

  {{ else if eq $net.type "nat" }}
    mgr_prepare_nat_net "{{ $netIndex }}"
    {{- $forwardRules := "" -}}
    {{- range $pIndex, $port := $net.ports -}}
      {{- $proto := default "tcp" $port.proto -}}
      {{- $forwardRules = printf "%s,hostfwd=%s::%d-:%d" $forwardRules $proto (int $port.host) (int $port.guest) -}}
    {{- end -}}

    read -r -a NET_ARGS <<< "$(cli_add_nat_network "{{ $netIndex }}" "{{ $forwardRules }}")"
    QEMU_CMD+=("${NET_ARGS[@]}")
  {{ end }}
{{ end }}
{{ end }}

{{ if and .vnc .vnc.enabled }}
  vnc_display=$(( {{ .vnc.port }} - 5900 ))
  QEMU_CMD+=("-vnc" "0.0.0.0:$vnc_display" "-vga" "std")
  websockify --web /usr/share/novnc/ "{{ .vnc.novnc_port }}" "127.0.0.1:{{ .vnc.port }}" > /dev/null 2>&1 &
{{ else }}
  QEMU_CMD+=("-nographic")
{{ end }}

echo "--> Launching QEMU..."
exec "${QEMU_CMD[@]}" {{ default "" .extra_args }}
